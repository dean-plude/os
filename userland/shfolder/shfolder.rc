/* shfolder.rc — shfolder's version resource, Windows 10 1903's.  Installers
 * that carry their own copy of the old redistributable shfolder.dll (Inno
 * Setup 4 and 5's _shfoldr.dll, version 5.50) use the system's when its
 * version is the same or newer, as it is on every Windows since 2000. */
1 VERSIONINFO
FILEVERSION 10,0,18362,1
PRODUCTVERSION 10,0,18362,1
FILEFLAGSMASK 0x3F
FILEFLAGS 0
FILEOS 0x40004
FILETYPE 2
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "NovaOS"
            VALUE "FileDescription", "Shell Folder Service"
            VALUE "FileVersion", "10.0.18362.1"
            VALUE "InternalName", "SHFOLDER"
            VALUE "OriginalFilename", "SHFOLDER.DLL"
            VALUE "ProductName", "NovaOS"
            VALUE "ProductVersion", "10.0.18362.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
