/* ntdll.rc — ntdll's version resource.  Windows 10 1903 is build 18362,
 * the build the PEB and KUSER_SHARED_DATA report and whose system-call
 * numbers ntdll uses; programs (Roblox's Hyperion) read ntdll's version
 * with LdrFindResource_U to tell which Windows they run on. */
1 VERSIONINFO
FILEVERSION 10,0,18362,1
PRODUCTVERSION 10,0,18362,1
FILEFLAGSMASK 0x3F
FILEFLAGS 0
FILEOS 0x40004
FILETYPE 2
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "NovaOS"
            VALUE "FileDescription", "NT Layer DLL"
            VALUE "FileVersion", "10.0.18362.1"
            VALUE "InternalName", "ntdll.dll"
            VALUE "OriginalFilename", "ntdll.dll"
            VALUE "ProductName", "NovaOS"
            VALUE "ProductVersion", "10.0.18362.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
